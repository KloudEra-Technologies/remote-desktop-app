{
  "name": "remote-desktop-app",
  "productName": "RemoteDesk",
  "version": "1.0.0",
  "description": "Remote desktop access app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.1.8"
  },
  "build": {
    "appId": "com.yourcompany.remotedesk",
    "productName": "RemoteDesk",
    "files": [
      "**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,readme.md}"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "your-github-username",
      "repo": "remote-desktop-app"
    }
  }
}
